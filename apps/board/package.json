{
  "name": "@brain-log/board",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build:sidecar && tauri dev",
    "dev:vite": "vite",
    "build": "pnpm build:sidecar && pnpm build:vite && tauri build",
    "build:vite": "vite build",
    "build:sidecar": "tsc -p sidecar/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p sidecar/tsconfig.json --noEmit",
    "tauri": "tauri",
    "test": "vitest run"
  },
  "dependencies": {
    "@brain-log/shared": "workspace:*",
    "@tauri-apps/api": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.4.0",
    "vite": "^5.4.11",
    "vitest": "^2.0.0"
  }
}
