{
  "name": "brain-log",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @brain-log/shared build && pnpm -r --parallel --stream dev",
    "dev:api": "pnpm --filter @brain-log/api dev",
    "dev:cli": "pnpm --filter brain-log dev",
    "dev:menubar": "pnpm --filter brain-log-menubar dev",
    "dev:shared": "pnpm --filter @brain-log/shared dev",
    "dev:board": "pnpm --filter @brain-log/shared build && pnpm --filter @brain-log/board dev",
    "build": "pnpm --filter @brain-log/shared build && pnpm --filter brain-log build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
